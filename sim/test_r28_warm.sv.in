`timescale 1ns/1ps
module tb_warm;
localparam integer WARM = @WARM@;
localparam integer INC = @INC@;
reg clk=0;always #10 clk=~clk;
reg handoff_reblend=0;
reg [223:0] saved_z;integer saved_age,saved_i,saved_lp;
reg rst_n=0,clear=0,start=0,automatic_policy=1,automatic_hold=1,automatic_brake=0,motion_assist_permission=0;
reg signed [31:0] fallback_duty=0,theta=0,phi=0,reference_offset=0,reference_velocity=0,previous_duty=0,prediction_duty=0,limit_permille=350;
wire busy,done,fault,ready;wire signed[31:0] duty;wire[223:0] debug_state;wire[7:0]debug_samples;wire signed[31:0]debug_integral,debug_lp;wire[9:0]debug_age;
r10_observer_core dut(.*);
integer count,cy,first_cy,normal_cy,manual_cy,j,k,first_blend=0,full_blend=0,first_ready=0,expected_blend=0;integer zero_checks=0,abort_checks=0;

task tick; begin @(posedge clk);#1;@(negedge clk);#1;end endtask
task reset;begin start=0;clear=0;rst_n=0;tick();rst_n=1;tick();end endtask
task nominal;begin theta=0;phi=0;motion_assist_permission=0;reference_offset=0;reference_velocity=0;previous_duty=0;limit_permille=350;fallback_duty=0;automatic_policy=1;automatic_hold=1;automatic_brake=0;end endtask
task launch;begin start=1;tick();start=0;end endtask
task complete;begin cy=0;while(!done&&cy<500)begin tick();cy=cy+1;end if(!done||fault)$fatal(1,"transaction failed cy=%0d fault=%0d",cy,fault);tick();end endtask
initial begin
 reset();
 for(j=0;j<8;j=j+1)begin
  reset();nominal();theta=j[0]? -1342:1576;phi=j[1]? -120000:134501;
  launch();theta=32'h7fffffff;phi=32'h80000000;
  count=0;while(dut.state!=1&&count<30)begin tick();count=count+1;end
  if(count!=2||debug_state!==0)$fatal(1,"zero initialization error j=%0d count=%0d",j,count);
  zero_checks=zero_checks+1;complete();
 end
 reset();nominal();launch();complete();first_cy=cy;launch();complete();normal_cy=cy;
 if(first_cy!=normal_cy)$fatal(1,"extra latency %0d/%0d",first_cy,normal_cy);
 reset();nominal();automatic_policy=0;launch();complete();manual_cy=cy;if(debug_state!=0||duty!=0)$fatal(1,"manual initialization changed");
 // Cancel initialization/early computation with clear and reset; no stale sample/PWM.
 for(k=0;k<2;k=k+1)begin
  for(j=0;j<10;j=j+1)begin
   reset();nominal();theta=100;phi=-200;launch();repeat(j)tick();
   if(k==0)clear=1;else rst_n=0;tick();
   if(busy||done||duty!=0||fault||ready||debug_state!=0||debug_samples!=0||debug_age!=0||dut.blend!=0)$fatal(1,"abort state j=%0d k=%0d",j,k);
   clear=0;rst_n=1;repeat(8)begin tick();if(done||busy||duty!=0)$fatal(1,"stale after abort");end
   nominal();theta=-200;phi=100;launch();complete();abort_checks=abort_checks+1;
  end
 end
 reset();nominal();expected_blend=0;
 for(j=1;j<=420;j=j+1)begin
  launch();complete();if(j>=WARM)begin expected_blend=expected_blend+INC;if(expected_blend>16777216)expected_blend=16777216;end
  if(dut.blend!=expected_blend||int'(debug_age)!=j||ready!=(j>=201))$fatal(1,"warm/ready mismatch n=%0d blend=%0d/%0d ready=%0d",j,dut.blend,expected_blend,ready);
  if(dut.blend>0&&first_blend==0)first_blend=j;if(dut.blend==16777216&&full_blend==0)full_blend=j;if(ready&&first_ready==0)first_ready=j;
 end
 // R29 re-entry resets only feedback blend, never observer state or integral.
 saved_z=debug_state;saved_age=debug_age;saved_i=debug_integral;saved_lp=debug_lp;
 handoff_reblend=1;tick();handoff_reblend=0;tick();
 if(dut.blend!=0||debug_state!==saved_z||debug_age!=saved_age||debug_integral!=saved_i||debug_lp!=saved_lp)$fatal(1,"reblend reset changed observer history");
 expected_blend=0;
 for(j=0;j<201;j=j+1)begin launch();complete();expected_blend=expected_blend+INC;if(expected_blend>16777216)expected_blend=16777216;
 if(dut.blend!=expected_blend)$fatal(1,"reblend progression mismatch");end
 // Runtime withdrawal works after mature mixed holding.
 automatic_hold=0;for(j=0;j<16;j=j+1)begin launch();complete();end
 if(dut.blend!=0)$fatal(1,"blend did not withdraw");
 $display("PASS zero_checks=%0d abort_checks=%0d first_auto_cycles=%0d regular_auto_cycles=%0d manual_cycles=%0d first_blend_sample=%0d full_blend_sample=%0d ready_sample=%0d",zero_checks,abort_checks,first_cy,normal_cy,manual_cy,first_blend,full_blend,first_ready);
 $finish;
end
endmodule
